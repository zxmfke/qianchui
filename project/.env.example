# ===== 千锤·营销话术AI操作系统 — 环境变量配置 =====

# ── 数据库 ──────────────────────────────────────────
POSTGRES_DB=qianchui
POSTGRES_USER=qianchui
POSTGRES_PASSWORD=qianchui123
POSTGRES_PORT=5432

# ── Redis ───────────────────────────────────────────
REDIS_PORT=6379

# ── 后端服务 ────────────────────────────────────────
BACKEND_PORT=8000
SECRET_KEY=change-this-in-production-use-openssl-rand-hex-32

# ── 前端/Nginx ──────────────────────────────────────
HTTP_PORT=80

# ── AI 大模型配置 ───────────────────────────────────
# 支持 openai / moonshot / deepseek / qwen 等兼容接口
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-api-key-here
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4
LLM_HTTP_PROXY=

# ── 日志配置 ─────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=text     # text (彩色控制台) | json (结构化，适合 ELK/Loki)
LOG_FILE=           # 留空=仅控制台；填路径如 /var/log/qianchui/app.log 开启文件输出

# ── Langfuse (LLM 可观测性) ─────────────────────────
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_SECRET_KEY=sk-lf-xxx
LANGFUSE_HOST=https://cloud.langfuse.com
